{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Renovate Dependency Dashboard",
  "dependencyDashboardLabels": [
    "dependencies"
  ],
  "assignees": [
    "the78mole"
  ],
  "reviewers": [
    "the78mole"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "npm"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "dockerfile"
      ]
    },
    {
      "matchFileNames": [
        "images/*/Dockerfile*"
      ],
      "addLabels": [
        "docker-images"
      ]
    },
    {
      "matchFileNames": [
        "images/kicaddev/requirements.txt"
      ],
      "addLabels": [
        "kicaddev",
        "python"
      ]
    },
    {
      "description": "KiCad needs pillow<10 (see #21) and pillow 9.5.0 has no wheels for the Python in Ubuntu 26.04, so keep this base image on 24.04.",
      "matchFileNames": [
        "images/kicaddev/Dockerfile"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/images/.+/Dockerfile[^/]*$/"
    ]
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/images/.+/requirements\\.txt$/"
    ]
  },
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "assignees": [
      "the78mole"
    ],
    "reviewers": [
      "the78mole"
    ]
  }
}
